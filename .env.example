# Environment Variables
# Copy this file to .env and fill in the values

# Database
POSTGRES_USER=digitus
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=digitus_engine
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://digitus:your_password_here@db:5432/digitus_engine

# Redis
REDIS_URL=redis://redis:6379/0

# AI API
GEMINI_API_KEY=your-gemini-api-key-here

# App
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Skorlama Katsayıları
ADS_EPSILON=0.01
SEO_COMPETITION_WEIGHT=1.0
SOCIAL_TREND_WEIGHT=3.0

# Ads generation
ADS_FALLBACK_ENABLED=true

# Google Ads API Probe (standalone test module)
# Fill these to test Google Ads API before product integration
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# Probe defaults
GOOGLE_ADS_LANGUAGE_ID=1037
GOOGLE_ADS_GEO_TARGET_ID=2792
GOOGLE_ADS_PROBE_PAGE_SIZE=1000
GOOGLE_ADS_PROBE_MAX_RESULTS=300
GOOGLE_ADS_PROBE_SEEDS=dijital pazarlama,seo ajansi
