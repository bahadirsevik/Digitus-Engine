# Environment Variables
# Copy this file to .env and fill in the values

# Database
POSTGRES_USER=digitus
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=digitus_engine
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://digitus:your_password_here@db:5432/digitus_engine

# Redis
REDIS_URL=redis://redis:6379/0

# AI API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# App
APP_ENV=development
DEBUG=true
SQL_ECHO=false
SECRET_KEY=your-secret-key-change-in-production

# Security
# API_KEY bos birakilirsa /api/v1/* koruma devre disidir (feature flag).
# Set edilirse tum istekler X-API-Key header'i ile gelmelidir.
# Uretim: zorunlu (openssl rand -hex 32 ile uretin).
API_KEY=
# Frontend'in ayni anahtari gondermesi icin (frontend/.env veya build env):
# VITE_API_KEY=<API_KEY ile ayni deger>
# CORS whitelist. Virgul ile ayrilmis origin listesi veya "*" (yalniz dev).
# Uretim: "*" yasaktir, tam URL verin.
CORS_ORIGINS=*

# Ads generation
ADS_FALLBACK_ENABLED=true

# New social brief workflow. Keep false until rollout is approved.
ENABLE_SOCIAL_BRIEF_FLOW=false

# Legacy /social/bulk gate (K12). False -> POST /generation/social/bulk
# returns 410 Gone once the brief flow is stable; keep true only during the
# transition window.
ENABLE_SOCIAL_LEGACY_BULK=false

# Google Ads API Probe (standalone test module)
# Fill these to test Google Ads API before product integration
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# Probe defaults
GOOGLE_ADS_LANGUAGE_ID=1037
GOOGLE_ADS_GEO_TARGET_ID=2792
GOOGLE_ADS_PROBE_PAGE_SIZE=1000
GOOGLE_ADS_PROBE_MAX_RESULTS=300
GOOGLE_ADS_PROBE_SEEDS=dijital pazarlama,seo ajansi

# V3 engine AI parallelism
# Per-run workers and the Redis-backed global limit.
ENGINE_AI_CONCURRENCY=16
ENGINE_AI_GLOBAL_INFLIGHT=16
