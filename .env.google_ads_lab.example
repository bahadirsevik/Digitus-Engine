# Google Ads Lab (isolated from product pipeline)
# Copy to .env.google_ads_lab and fill values.

GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-mcc-customer-id
GOOGLE_ADS_CUSTOMER_ID=your-customer-id


# Defaults
GOOGLE_ADS_LANGUAGE_ID=1037
GOOGLE_ADS_GEO_TARGET_ID=2792
GOOGLE_ADS_PROBE_PAGE_SIZE=1000
GOOGLE_ADS_PROBE_SEEDS=dijital pazarlama,seo ajansi
